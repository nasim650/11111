# Production PostgreSQL (Khati Khadyo)
#
# In production this points to Neon serverless Postgres:
#   DATABASE_URL  → Neon pooled connection string (...-pooler.neon.tech/...)
#   DIRECT_URL    → Neon direct connection string (...neon.tech/...)
#
# For this deployment the target is a local PostgreSQL 16.4 instance
# (built from source). Both URLs point to the same local server; the
# pooled/direct split is preserved so swapping to real Neon is a one-line
# change per variable.
#
# App runtime (pooled-style):
DATABASE_URL=postgresql://neondb_owner:npg_V5uRnbEZUf6L@ep-snowy-paper-aotetbbn-pooler.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Migrations (direct-style):
DIRECT_URL=postgresql://neondb_owner:npg_V5uRnbEZUf6L@ep-snowy-paper-aotetbbn.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ─── Auth Secrets ──────────────────────────────────────────────────────────
JWT_SECRET="khati-khadyo-secret-key-2026-bangladesh"
NEXTAUTH_SECRET="khati-khadyo-nextauth-secret-2026"

# ─── Cloudinary (media storage) ────────────────────────────────────────────
# Production values come from the Cloudinary console. When all three are set,
# /api/uploads uploads to Cloudinary and deleteManagedMedia() removes assets
# from Cloudinary. When unset, uploads fall back to the local /public/uploads
# directory (dev only).
CLOUDINARY_CLOUD_NAME=dwn70azbb
CLOUDINARY_API_KEY=615631526737825
CLOUDINARY_API_SECRET=Hr9fLfLBhgVHR-IoOJUbZChDMH4

# ─── SSLCommerz (payment gateway) ──────────────────────────────────────────
# Production values come from the SSLCommerz merchant console.
# SSLCOMMERZ_IS_LIVE switches between sandbox (false) and live (true).
# Callback URLs must be public HTTPS endpoints reachable by SSLCommerz.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_LIVE=false
SSLCOMMERZ_SUCCESS_URL=
SSLCOMMERZ_FAIL_URL=
SSLCOMMERZ_CANCEL_URL=
SSLCOMMERZ_IPN_URL=
