# Copy this file to .env.local for local development. Never commit real values.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
JWT_SECRET="replace-with-a-unique-random-secret-of-at-least-32-characters"

# Required to activate SMS OTP (password reset and phone verification).
OTP_SECRET="replace-with-a-different-random-secret-of-at-least-32-characters"
SMS_GATEWAY_URL="https://your-sms-provider.example/api/messages"
SMS_GATEWAY_TOKEN=""
SMS_SENDER_ID=""

# Required for shared rate limiting on Vercel or any multi-instance deployment.
REDIS_URL="redis://USER:PASSWORD@HOST:PORT"

NEXT_PUBLIC_APP_URL="https://your-domain.example"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASSWORD=""
SSLCOMMERZ_IS_LIVE="false"
SSLCOMMERZ_SUCCESS_URL="https://your-domain.example/api/payments/sslcommerz/success"
SSLCOMMERZ_FAIL_URL="https://your-domain.example/api/payments/sslcommerz/fail"
SSLCOMMERZ_CANCEL_URL="https://your-domain.example/api/payments/sslcommerz/cancel"
SSLCOMMERZ_IPN_URL="https://your-domain.example/api/payments/sslcommerz/ipn"
